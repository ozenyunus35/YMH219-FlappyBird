<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FlappyBird</RootNamespace>
    <AssemblyName>FlappyBird</AssemblyName>
    <!-- Daha yeni bir .NET sürümü kurulu bilgisayarlarda da açılabilsin -->
    <RollForward>Major</RollForward>
    <!-- Windows dışı makinelerde de derleme hatası vermesin -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Flappy Bird - YMH219</Product>
    <Version>1.1.0</Version>
  </PropertyGroup>

</Project>
